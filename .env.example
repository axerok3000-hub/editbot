# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Суффикс, который запускает анимацию печати (по умолчанию .p)
TYPEWRITER_SUFFIX=.p

# Сколько символов открывается за один edit_message_text
TYPEWRITER_CHUNK_SIZE=2

# Базовая задержка между edit-ами, в миллисекундах
TYPEWRITER_DELAY_MS=250

# Путь к файлу, где хранятся business_connection_id -> owner_user_id
CONNECTIONS_FILE=storage/connections.json
