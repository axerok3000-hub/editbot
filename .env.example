# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Твой личный Telegram user_id — только этот id может писать боту
# команды (/start, /exclude, /include) и нажимать инлайн-кнопки
OWNER_ID=123456789

# Суффикс, который запускает анимацию печати (по умолчанию .p)
TYPEWRITER_SUFFIX=.p

# Путь к файлу, где хранятся business_connection_id -> {owner_id, is_enabled}
CONNECTIONS_FILE=storage/connections.json

# Путь к файлу со списком chat_id, исключённых из анимации печати
EXCLUDED_CHATS_FILE=storage/excluded_chats.json

# Путь к SQLite-базе с кэшем сообщений собеседников (анти-удаление)
CACHE_DB_FILE=storage/cache.db

# Сколько дней хранить закэшированные сообщения перед очисткой (раз в час)
CACHE_RETENTION_DAYS=7
